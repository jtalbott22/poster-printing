# =====================================================================
#  Poster Portal — copy to .env and fill in. chmod 600.
# =====================================================================

NODE_ENV=production
PORT=3000
BIND_HOST=127.0.0.1
PUBLIC_URL=https://posters.kent.edu

# --- storage ---------------------------------------------------------
# Everything lives under here: the SQLite file, the blob store, renditions,
# upload scratch. Must be ONE filesystem — uploads are moved with rename().
DATA_ROOT=/var/lib/poster-portal
# DB_PATH=/var/lib/poster-portal/poster-portal.db

# --- Google sign-in ---------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI: https://posters.kent.edu/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=kent.edu
# Comma-separated. These accounts become admin on first sign-in.
BOOTSTRAP_ADMINS=you@kent.edu

# --- secrets (openssl rand -hex 32) ----------------------------------
COOKIE_SECRET=
FLOW_SHARED_SECRET=
SESSION_DAYS=7

# --- print rules ------------------------------------------------------
TARGET_DPI=300
MIN_DPI=150
WARN_DPI=200
ROLL_WIDTHS=36,42
EDGE_MARGIN_IN=0.25
MIN_LENGTH_IN=8
MAX_LENGTH_IN=120
MAX_ASPECT=6
MAX_UPLOAD_MB=250
PREVIEW_MAX_PX=1600
THUMB_MAX_PX=480
MAX_PRINT_MP=400
# png = lossless, but a photo-heavy 42x36 can reach 400 MB.
# jpeg = about 4.5x smaller, invisible at viewing distance, but shows ringing
# on fine line art and small coloured type. Start with png; switch only if the
# file sizes become an operational problem.
PRINT_FORMAT=png
PRINT_JPEG_QUALITY=95

# --- conversion toolchain --------------------------------------------
RENDER_CONCURRENCY=2
SOFFICE_BIN=/usr/bin/soffice
PDFTOPPM_BIN=/usr/bin/pdftoppm
PDFINFO_BIN=/usr/bin/pdfinfo
CHROMIUM_BIN=/usr/bin/chromium
CONVERT_TIMEOUT_MS=180000

# --- Power Automate ---------------------------------------------------
# HTTP-trigger URLs from the two flows. Leave blank to run portal-only
# approvals (the admin console still works).
FLOW_SUBMIT_URL=
FLOW_NOTIFY_URL=
APPROVAL_DEADLINE_HOURS=48
OUTBOX_RETRY_BASE_MS=15000
OUTBOX_MAX_ATTEMPTS=12

# --- retention --------------------------------------------------------
RETENTION_HEAVY_DAYS=30
RETENTION_LIGHT_DAYS=400
SPOOLER_RECORD_DAYS=2

# --- features ---------------------------------------------------------
FEATURE_CAMERAS=false
FEATURE_SUPPLIES=true
FEATURE_HTML_UPLOADS=true
HLS_ROOT=/var/lib/poster-portal/hls
