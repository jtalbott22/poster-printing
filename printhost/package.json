{
  "name": "poster-print-agent",
  "version": "1.0.0",
  "description": "Windows print host agent for the KSU poster portal",
  "main": "agent.js",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "start": "node agent.js",
    "install-service": "node-windows-install",
    "test-print": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Get-PosterQueue.ps1 -ListPrinters"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
