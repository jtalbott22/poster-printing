# =====================================================================
#  Poster print agent — C:\PosterPrint\.env   (restrict ACL to the
#  service account; this file contains a shared secret)
# =====================================================================

# Must match the printers.print_host_id -> print_hosts.code row in the portal
PP_HOST_CODE=bowman-01

PP_PORTAL_URL=https://posters.kent.edu

# From `npm run seed` on the portal, or POST /api/admin/hosts
PP_HMAC_SECRET=

# The portal connects in to this. Open only to the portal's IP.
PP_LISTEN_PORT=8443
PP_LISTEN_HOST=0.0.0.0
PP_TLS_CERT=C:\PosterPrint\certs\agent.crt
PP_TLS_KEY=C:\PosterPrint\certs\agent.key

PP_SPOOL_DIR=C:\ProgramData\PosterPrint\spool
PP_STATE_FILE=C:\ProgramData\PosterPrint\state.json
PP_SCRIPT_DIR=C:\PosterPrint\scripts

# 64-bit Windows PowerShell 5.1. Do not point this at pwsh.exe.
PP_POWERSHELL=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe

PP_POLL_MS=4000
PP_REAP_AFTER_HOURS=48
PP_KEEP_SPOOL_FILES=false
